---
import type { Woman } from '../types';

interface Props {
	woman: Woman;
	featured?: boolean;
}

const { woman, featured = false } = Astro.props;
const lifespan = woman.died
	? `${woman.born.display} – ${woman.died.display}`
	: `Born ${woman.born.display}`;
const profileUrl = woman.profileUrl ?? woman.wikipediaUrl!;
const profileLabel = woman.profileLabel ?? 'Wikipedia';
const searchText = [woman.name, woman.fullName, woman.summary, ...woman.categories].join(' ');
---

<article
	class:list={['woman-card', { featured }]}
	data-card
	data-hidden={String(Boolean(woman.hidden))}
	data-names={`${woman.name} ${woman.fullName}`}
	data-search={searchText}
	data-categories={woman.categories.join('|')}
	hidden={woman.hidden}
>
	<a class="card-image" href={`/women/${woman.slug}/`} aria-label={`Read about ${woman.name}`}>
		<img
			src={woman.image.url}
			alt={woman.image.alt}
			loading={featured ? 'eager' : 'lazy'}
			referrerpolicy="no-referrer"
		/>
		<span class="image-shade"></span>
		<div class="card-heading">
			<div class="category-list">
				{woman.categories.map((category) => <span class="category">{category}</span>)}
			</div>
			<h3>{woman.name}</h3>
			{woman.showLifeDates !== false && <p>{lifespan}</p>}
		</div>
	</a>
	<div class="card-body">
		<p>{woman.summary}</p>
		<div class="card-actions">
			<div class="card-links">
				<a class="text-link" href={`/women/${woman.slug}/`}>Explore her story <span aria-hidden="true">→</span></a>
				<a class="wikipedia-link" href={profileUrl} title={`${woman.name} on ${profileLabel}`} rel="noreferrer">{profileLabel} <span aria-hidden="true">↗</span></a>
			</div>
			<button
				class="favorite-button"
				type="button"
				data-favorite={woman.slug}
				aria-label={`Add ${woman.name} to favorites`}
				aria-pressed="false"
			>
				<span aria-hidden="true">♡</span>
			</button>
		</div>
	</div>
</article>
