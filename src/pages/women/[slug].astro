---
import catalogData from '../../data/women.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertCatalog, categorySlug, listedWomen } from '../../lib/catalog';
import { portraitSrcSet } from '../../lib/images';
import type { Woman } from '../../types';

assertCatalog(catalogData);
export function getStaticPaths() {
	assertCatalog(catalogData);
	const women = [...catalogData].sort((a, b) => a.name.localeCompare(b.name));
	const listed = listedWomen(women);
	return women.map((woman) => {
		const listedIndex = listed.findIndex((entry) => entry.slug === woman.slug);
		const nextIndex = listedIndex >= 0
			? (listedIndex + 1) % listed.length
			: Math.max(0, listed.findIndex((entry) => entry.name.localeCompare(woman.name) > 0));
		const previousIndex = listedIndex >= 0
			? (listedIndex - 1 + listed.length) % listed.length
			: (nextIndex - 1 + listed.length) % listed.length;
		return {
			params: { slug: woman.slug },
			props: { woman, previous: listed[previousIndex], next: listed[nextIndex] },
		};
	});
}
interface Props {
	woman: Woman;
	previous: Woman;
	next: Woman;
}
const { woman, previous, next } = Astro.props;
const lifespan = woman.died ? `${woman.born.display} – ${woman.died.display}` : `Born ${woman.born.display}`;
const profileUrl = woman.profileUrl ?? woman.wikipediaUrl!;
const profileLabel = woman.profileLabel ?? 'Wikipedia';
const profilePageUrl = new URL(`/women/${woman.slug}/`, Astro.site);
const profileSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		name: `${woman.name}: Biography and Achievements`,
		headline: woman.name,
		description: woman.summary,
		url: profilePageUrl,
		mainEntity: {
			'@type': 'Person',
			name: woman.fullName,
			alternateName: woman.name === woman.fullName ? undefined : woman.name,
			description: woman.summary,
			image: new URL(woman.image.url, Astro.site),
			birthDate: woman.born.date ?? undefined,
			deathDate: woman.died?.date ?? undefined,
			knowsAbout: woman.categories,
			sameAs: [profileUrl],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site) },
			{ '@type': 'ListItem', position: 2, name: 'Catalog', item: new URL('/catalog/', Astro.site) },
			{ '@type': 'ListItem', position: 3, name: woman.name, item: profilePageUrl },
		],
	},
];
---

<BaseLayout
	title={`${woman.name}: Biography and Achievements`}
	description={woman.summary}
	brandHref="/catalog/"
	noindex={woman.hidden}
	image={woman.image.url}
	imageAlt={woman.image.alt}
	pageType="profile"
	structuredData={profileSchema}
>
	<article class="profile">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span aria-hidden="true">/</span>
			<a href="/catalog/">Catalog</a><span aria-hidden="true">/</span>
			<span aria-current="page">{woman.name}</span>
		</nav>
		<header class="profile-hero">
			<div class="profile-image-wrap">
				<picture>
					<source type="image/avif" srcset={portraitSrcSet(woman.slug, 'avif')} sizes="(max-width: 900px) calc(100vw - 2.5rem), 500px" />
					<source type="image/webp" srcset={portraitSrcSet(woman.slug, 'webp')} sizes="(max-width: 900px) calc(100vw - 2.5rem), 500px" />
					<img src={woman.image.url} alt={woman.image.alt} width="800" height="1000" decoding="async" fetchpriority="high" />
				</picture>
			</div>
			<div class="profile-intro">
				<div class="category-list">{woman.categories.map((category) => <a class="category" href={`/categories/${categorySlug(category)}/`}>{category}</a>)}</div>
				<p class="eyebrow">A legendary life</p>
				<div class="profile-title-row">
					<h1>{woman.name}</h1>
					<button
						id="profile-favorite"
						class="favorite-button profile-favorite"
						type="button"
						data-favorite={woman.slug}
						data-favorite-name={woman.name}
						aria-label={`Add ${woman.name} to favorites`}
						aria-pressed="false"
					>
						<span aria-hidden="true">♡</span>
					</button>
				</div>
				{woman.fullName !== woman.name && <p class="full-name">{woman.fullName}</p>}
				{woman.showLifeDates !== false && <p class="lifespan">{lifespan}</p>}
				<p class="profile-summary">{woman.summary}</p>
			</div>
		</header>
		<div class="profile-grid">
			<div class="profile-main">
				<section><p class="eyebrow">Her story</p><h2>A life that changed history</h2><p class="bio">{woman.bio}</p></section>
				{(woman.quotes?.length ? woman.quotes : woman.quote ? [woman.quote] : []).map((quote) => <blockquote><p>“{quote.text}”</p><cite>{quote.source}</cite></blockquote>)}
			</div>
			<aside class="accomplishments">
				<p class="eyebrow">Landmarks</p><h2>Key accomplishments</h2>
				<ol>{woman.accomplishments.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>)}</ol>
			</aside>
		</div>
		<footer class="profile-sources">
			<div><p class="eyebrow">Provenance</p><h2>Sources & image</h2></div>
			<ul>
				{woman.sources.map((source) => (
					<li class="content-credit">
						{source.url
							? <a href={source.url} rel="noreferrer" target="_blank">{source.label} ↗</a>
							: <span>{source.label}</span>}
					</li>
				))}
				<li class="image-credit">
					<span>
						Image: <strong>{woman.image.credit}</strong> ({woman.image.license}).
						<a href={woman.image.source} rel="noreferrer" target="_blank"> Source ↗</a>
					</span>
				</li>
			</ul>
		</footer>
		<a class="wiki-article-link" href={profileUrl} title={`${woman.name} on ${profileLabel}`} rel="noreferrer">
			<span><small>Continue reading</small><strong>View {woman.name} on {profileLabel}</strong></span>
			<span aria-hidden="true">↗</span>
		</a>
		<nav class="profile-navigation" aria-label="Browse profiles">
			<a id="previous-profile" href={`/women/${previous.slug}/`} rel="prev" aria-keyshortcuts="ArrowLeft">
				<span aria-hidden="true">←</span>
				<span><small>Previous legend</small><strong>{previous.name}</strong></span>
			</a>
			<a id="next-profile" href={`/women/${next.slug}/`} rel="next" aria-keyshortcuts="ArrowRight">
				<span><small>Next legend</small><strong>{next.name}</strong></span>
				<span aria-hidden="true">→</span>
			</a>
		</nav>
	</article>
</BaseLayout>

<script>
	import { getFavorites, toggleFavorite, updateFavoriteButton } from '../../lib/favorites';

	const favoriteButton = document.querySelector<HTMLButtonElement>('#profile-favorite');
	if (favoriteButton) {
		updateFavoriteButton(favoriteButton, getFavorites());
		favoriteButton.addEventListener('click', () => {
			const favorites = toggleFavorite(favoriteButton.dataset.favorite!, 'profile');
			updateFavoriteButton(favoriteButton, favorites);
		});
	}

	const navigateToProfile = (linkId: 'previous-profile' | 'next-profile') => {
		const link = document.querySelector<HTMLAnchorElement>(`#${linkId}`);
		if (link) window.location.assign(link.href);
	};

	document.addEventListener('keydown', (event) => {
		if (
			event.defaultPrevented
			|| event.altKey
			|| event.ctrlKey
			|| event.metaKey
			|| event.shiftKey
			|| event.target instanceof HTMLInputElement
			|| event.target instanceof HTMLTextAreaElement
			|| event.target instanceof HTMLSelectElement
			|| event.target instanceof HTMLButtonElement
			|| (event.target instanceof HTMLElement && event.target.isContentEditable)
		) return;

		const linkId = event.key === 'ArrowLeft'
			? 'previous-profile'
			: event.key === 'ArrowRight'
				? 'next-profile'
				: null;
		if (!linkId) return;

		navigateToProfile(linkId);
	});

	const profile = document.querySelector<HTMLElement>('.profile');
	let touchStart: { x: number; y: number; time: number } | null = null;

	profile?.addEventListener('touchstart', (event) => {
		if (event.touches.length !== 1) {
			touchStart = null;
			return;
		}

		const touch = event.touches[0];
		touchStart = { x: touch.clientX, y: touch.clientY, time: performance.now() };
	}, { passive: true });

	profile?.addEventListener('touchend', (event) => {
		if (!touchStart || event.changedTouches.length !== 1) {
			touchStart = null;
			return;
		}

		const touch = event.changedTouches[0];
		const horizontalDistance = touch.clientX - touchStart.x;
		const verticalDistance = touch.clientY - touchStart.y;
		const duration = performance.now() - touchStart.time;
		const threshold = Math.min(120, Math.max(60, window.innerWidth * 0.12));
		touchStart = null;

		if (
			duration > 800
			|| Math.abs(horizontalDistance) < threshold
			|| Math.abs(horizontalDistance) < Math.abs(verticalDistance) * 1.5
		) return;

		navigateToProfile(horizontalDistance < 0 ? 'next-profile' : 'previous-profile');
	}, { passive: true });

	profile?.addEventListener('touchcancel', () => {
		touchStart = null;
	}, { passive: true });
</script>
