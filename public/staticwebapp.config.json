{
	"trailingSlash": "auto",
	"routes": [
		{
			"route": "/list*",
			"rewrite": "/list.txt"
		}
	],
	"responseOverrides": {
		"404": {
			"rewrite": "/404.html",
			"statusCode": 404
		}
	},
	"globalHeaders": {
		"Referrer-Policy": "strict-origin-when-cross-origin",
		"X-Content-Type-Options": "nosniff",
		"Permissions-Policy": "camera=(), microphone=(), geolocation=()"
	},
	"mimeTypes": {
		".webmanifest": "application/manifest+json",
		".txt": "text/plain",
		".xml": "application/xml"
	}
}
